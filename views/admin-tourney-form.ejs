<%- include('partials/header', { user: user }) %>
<div class="page-header">
  <a class="button-secondary back-button" href="<%= tourney ? '/admin' : '/admin' %>">← Voltar</a>
  <h1><%= tourney ? 'Editar torneio' : 'Criar novo torneio' %></h1>
</div>
<div class="card">
  <% if (message) { %>
    <div class="alert"><%= message %></div>
  <% } %>
  <form method="post" action="<%= tourney ? `/admin/tourney/${tourney.id}/edit` : '/admin/tourney' %>" class="form-grid">
    <label>Nome do torneio</label>
    <input type="text" name="name" value="<%= tourney ? tourney.name : '' %>" required />
    <label>Data</label>
    <input type="date" name="date" value="<%= tourney ? tourney.date : '' %>" required />
    <label>Local</label>
    <input type="text" name="location" value="<%= tourney ? tourney.location : '' %>" required />
    <label>Descrição</label>
    <textarea name="description" rows="4"><%= tourney ? tourney.description : '' %></textarea>
    <button type="submit"><%= tourney ? 'Salvar mudanças' : 'Criar torneio' %></button>
  </form>
  <% if (tourney) { %>
    <form method="post" action="/admin/tourney/<%= tourney.id %>/delete" onsubmit="return confirm('Tem certeza que deseja excluir este torneio?');" class="delete-form">
      <button type="submit" class="button-danger">Excluir torneio</button>
    </form>
  <% } %>
</div>
<%- include('partials/footer') %>
